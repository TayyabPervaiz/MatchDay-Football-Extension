{
  "manifest_version": 3,
  "name": "MatchDay - Football Fixtures",
  "version": "1.1.0",
  "description": "Track upcoming football matches from top leagues worldwide. Follow your favorite clubs and never miss a game.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://openfootapi.com/*",
    "https://api.football-data.org/*",
    "https://a.espncdn.com/*",
    "https://www.thesportsdb.com/*",
    "https://r2.thesportsdb.com/*",
    "https://vipbox.ga/*",
    "https://vipbox.lc/*",
    "https://vipbox.be/*",
    "https://hoofoot.net/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "matchday-fixtures@tayyab.dev",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
